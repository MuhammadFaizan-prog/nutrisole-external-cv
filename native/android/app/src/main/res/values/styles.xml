<resources>
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowBackground">@color/brand_cream</item>
    <item name="android:colorAccent">@color/brand_green</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:navigationBarColor">@color/brand_cream</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
  </style>
  <style name="LaunchTheme" parent="AppTheme"><item name="android:windowBackground">@drawable/launch_background</item></style>
</resources>
